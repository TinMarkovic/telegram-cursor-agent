# Required secrets / identity
TELEGRAM_BOT_TOKEN=
CURSOR_API_KEY=
ALLOWED_SENDER_IDS=

# Docker (compose.yml): host path mounted at /workspace inside the container.
# Compose sets WORKSPACE_PATH=/workspace for you — do not set WORKSPACE_PATH here.
TCA_WORKSPACE=

# Bare-metal / no-Docker without config.toml: absolute path the agent operates on.
# (Ignored when config.toml is present; Docker users leave this unset.)
# WORKSPACE_PATH=
